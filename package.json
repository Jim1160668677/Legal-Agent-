{
  "version": "0.1.0",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "joi": "^17.13.0",
    "mongoose": "^8.0.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "name": "legal-agent",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke": "tsx src/scripts/agnes-smoke.ts",
    "eval:intent": "tsx src/scripts/intent-eval.ts",
    "eval:retrieval": "node -r @swc-node/register src/scripts/retrieval-eval.ts",
    "eval:document": "tsx src/scripts/document-eval.ts",
    "eval:orchestration": "tsx src/scripts/orchestration-eval.ts",
    "eval:tool": "tsx src/scripts/tool-eval.ts",
    "eval:lawyer-review": "node -r @swc-node/register src/scripts/lawyer-review-eval.ts",
    "import:knowledge": "node -r @swc-node/register src/scripts/import-legal-knowledge.ts",
    "import:law": "node -r @swc-node/register src/scripts/import-law-articles.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=json --outputFile=reports/test-results.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r @swc-node/register src/main.ts",
    "test": "vitest run",
    "test:agnes": "vitest run tests/integration/agnes/ tests/e2e/",
    "test:unit": "vitest run tests/unit/",
    "build:vercel": "cd 各版本/common/sdk && npm install && npm run build && cd ../../web && npm install && npm run build",
    "deploy:vercel": "vercel --prod",
    "test:serverless": "node -r @swc-node/register scripts/test-serverless.ts",
    "seed:lawyer-expertise": "node -r @swc-node/register scripts/seed-lawyer-expertise.ts",
    "electron:dev": "concurrently \"npm run start:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && cd electron && npm install && npm run build",
    "build:win": "npm run build && cd electron && npm install && npm run build:win",
    "build:mac": "npm run build && cd electron && npm install && npm run build:mac",
    "build:linux": "npm run build && cd electron && npm install && npm run build:linux"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.4.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "description": "Legal Agent — NestJS legal AI service (Agnes LLM + intent router + hybrid retrieval)",
  "build": {
    "appId": "com.legal-agent.app",
    "productName": "法律智能体",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
