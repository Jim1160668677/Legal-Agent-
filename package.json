{
  "version": "0.1.0",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "joi": "^17.13.0",
    "mongoose": "^8.0.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "name": "legal-agent",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke": "tsx src/scripts/agnes-smoke.ts",
    "eval:intent": "tsx src/scripts/intent-eval.ts",
    "eval:retrieval": "node -r @swc-node/register src/scripts/retrieval-eval.ts",
    "eval:document": "tsx src/scripts/document-eval.ts",
    "import:knowledge": "node -r @swc-node/register src/scripts/import-legal-knowledge.ts",
    "import:law": "node -r @swc-node/register src/scripts/import-law-articles.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=json --outputFile=reports/test-results.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:agnes": "vitest run tests/integration/agnes/ tests/e2e/",
    "test:unit": "vitest run tests/unit/"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^1.6.0"
  },
  "description": "Legal Agent — NestJS legal AI service (Agnes LLM + intent router + hybrid retrieval)"
}
