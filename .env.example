# === NestJS 应用（A1-W1）===
NODE_ENV=dev
PORT=3000

# MongoDB（D-1：Atlas M10+ 或自建；本地开发可用 mongodb://localhost:27017/legal-agent）
MONGO_URI=mongodb://localhost:27017/legal-agent

# Redis（D-2：托管或自建；本地开发可用 redis://localhost:6379）
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=legal:

# JWT（A1-W2 AuthService 用；生产环境务必替换为强随机密钥）
JWT_SECRET=dev-secret-change-in-prod-32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# === LLM 供应商（现有 llm 层）===
LLM_PROVIDER=agnes

# Agnes（OpenAI 兼容）
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_DEFAULT_MODEL=agnes-2.0-flash

# Qwen（桩，预留）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-max

# 智谱 GLM（OpenAI 兼容；免费模型 glm-4.7-flash，200K 上下文，128K 最大输出）
# 官网申请 key: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4.7-flash
# 智谱思考模式（设为 enabled 启用深度思考，默认关闭节省 token）
ZHIPU_THINKING=

# 通用 LLM
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=1000
LLM_LOG_LEVEL=info

# === 限流（A1 §4.1）===
RATE_PER_USER_CHAT_PER_MIN=20
RATE_PER_USER_LLM_PER_DAY=50
RATE_GLOBAL_CHAT_QPS=500

# === PII 加密（A1-W2 PiiService；可选，缺失则由 JWT_SECRET 派生）===
PII_ENCRYPTION_KEY=

# === Embedding 向量化（A2-W2；默认 mock 无外部依赖，生产切换 agnes）===
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://apihub.agnes-ai.com/v1
EMBEDDING_MODEL=agnes-embedding-2.0
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_TTL_SEC=2592000

# === 日志级别（A1-W2 LoggerService）===
LOG_LEVEL=info

# === CORS / Swagger / Throttle（Phase 2 A5 关键项）===
# CORS 允许源（逗号分隔；留空 = 拒绝所有跨域 origin:false；开发期放开 Taro H5 / Vite 端口）
# 生产环境必须收紧到具体域名，如 https://h5.legal.example.com,https://admin.legal.example.com
CORS_ORIGINS=http://localhost:10086,http://localhost:3001,http://localhost:5173
# Swagger 文档（生产环境必须设为 false，关闭 /docs 暴露）
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
# 全局限流（@nestjs/throttler，按 IP 计数；ChatController 与 HealthController 已 @SkipThrottler 豁免）
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_DAILY_LIMIT=10000

# === 视觉模型（图像识别多模型主备切换，v2.4）===
# 主模型：glm-4v-flash（完全免费）；备用模型：glm-4v-plus（高性能视觉模型）
VISION_PRIMARY_MODEL=glm-4v-flash
VISION_FALLBACK_MODEL=glm-4v-plus
VISION_TIMEOUT_MS=30000
VISION_MAX_RETRIES=2
VISION_COOLDOWN_MS=30000