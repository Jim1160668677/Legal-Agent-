# === 生产环境变量模板 ===
# 复制为 .env.prod 后填写真实值

# 运行环境
NODE_ENV=prod
PORT=3000

# MongoDB - 生产数据库连接（需要认证）
# 格式：mongodb://用户名:密码@主机:端口/数据库名?authSource=admin
MONGO_URI=mongodb://legal:${MONGO_PASSWORD}@mongo:27017/legal_agent?authSource=admin
MONGO_ROOT_USER=legal
MONGO_PASSWORD=<生产MongoDB超级用户密码，至少16字符>

# Redis - 生产缓存
# 格式：redis://:密码@主机:端口
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=<生产Redis密码，至少16字符>
REDIS_KEY_PREFIX=legal:

# JWT - 生产密钥（必须 ≥32 字符随机字符串）
JWT_SECRET=<生产JWT密钥，至少32字符随机字符串>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS - 仅允许指定的前端域名
# 生产环境必须设置为具体域名，不允许通配符
CORS_ORIGINS=https://legal.example.com

# Swagger - 生产环境必须关闭
SWAGGER_ENABLED=false
SWAGGER_PATH=/docs

# LLM 配置
LLM_PROVIDER=agnes
AGNES_API_KEY=${AGNES_API_KEY}
ZHIPU_API_KEY=${ZHIPU_API_KEY}

# PII 加密密钥（可选，缺失则由 JWT_SECRET 派生）
PII_ENCRYPTION_KEY=<PII加密密钥，至少32字符随机字符串>

# 日志级别
LOG_LEVEL=info

# 限流配置
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_DAILY_LIMIT=10000
RATE_PER_USER_CHAT_PER_MIN=20
RATE_PER_USER_LLM_PER_DAY=50
RATE_GLOBAL_CHAT_QPS=500

# 视觉模型配置
VISION_PRIMARY_MODEL=glm-4v-flash
VISION_FALLBACK_MODEL=glm-4v-plus
