/* pages/chat/chat.wxss */

.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 会话列表 */
.session-list {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.session-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.new-chat-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.4;
}

.session-list-content {
  flex: 1;
  overflow-y: auto;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.session-item:active {
  background-color: #f5f5f5;
}

.session-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}

.session-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.session-intent {
  display: block;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.session-delete {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  color: #999;
  font-size: 36rpx;
}

.session-delete:active {
  color: #ff4d4f;
}

/* 聊天界面 */
.chat-interface {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.back-btn {
  background: none;
  border: none;
  font-size: 32rpx;
  color: #1890ff;
  padding: 0;
  line-height: 1;
}

.chat-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 60rpx;
}

.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
}

.user-message {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.user-avatar {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  margin-left: 16rpx;
}

.ai-avatar {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  margin-right: 16rpx;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
}

.user-content {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  margin-left: auto;
}

.ai-content {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.message-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.user-content .message-text {
  color: #fff;
}

.ai-content .message-text {
  color: #333;
}

.message-time {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.7;
}

.user-content .message-time {
  color: rgba(255, 255, 255, 0.8);
  text-align: right;
}

.ai-content .message-time {
  color: #999;
}

/* 加载动画 */
.loading-message {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #1890ff;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-tools {
  padding-bottom: 16rpx;
}

.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 32rpx;
}

.input-wrapper {
  flex: 1;
  margin: 0 16rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
}

.message-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  max-height: 200rpx;
  line-height: 1.5;
}

.send-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: none;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.send-btn.disabled {
  background: #ccc;
}
