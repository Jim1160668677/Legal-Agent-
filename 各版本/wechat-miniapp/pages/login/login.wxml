<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- 自定义导航栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px"></view>
  <view class="nav-bar">
    <text class="nav-title">法律智能体</text>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-icon">⚖️</view>
    <text class="app-name">法律智能体</text>
    <text class="app-desc">您的AI法律助手</text>
  </view>

  <!-- 登录表单 -->
  <view class="login-form">
    <view class="form-item">
      <view class="input-icon">👤</view>
      <input
        class="input"
        type="text"
        placeholder="请输入用户名/手机号"
        placeholder-class="placeholder"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="form-item">
      <view class="input-icon">🔒</view>
      <input
        class="input"
        type="password"
        password
        placeholder="请输入密码"
        placeholder-class="placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="remember-row">
      <checkbox-group bindchange="onRememberChange">
        <label class="remember-label">
          <checkbox value="remember" checked="{{remember}}" color="#1890ff" />
          <text class="remember-text">记住密码</text>
        </label>
      </checkbox-group>
      <text class="forgot-link" bindtap="onForgotPassword">忘记密码?</text>
    </view>

    <button class="login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">
      登 录
    </button>

    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <view class="wechat-login" bindtap="onWechatLogin">
      <view class="wechat-icon">💬</view>
      <text class="wechat-text">微信一键登录</text>
    </view>
  </view>

  <!-- 协议 -->
  <view class="agreement">
    <checkbox-group bindchange="onAgreeChange">
      <label class="agreement-label">
        <checkbox value="agree" checked="{{agreed}}" color="#1890ff" />
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link" bindtap="onViewAgreement">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bindtap="onViewPrivacy">《隐私政策》</text>
      </label>
    </checkbox-group>
  </view>
</view>
