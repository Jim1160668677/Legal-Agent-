/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  padding: 0 48rpx;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.app-desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.login-form {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 60rpx 48rpx;
  margin-top: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #999;
}

.remember-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.remember-label {
  display: flex;
  align-items: center;
}

.remember-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}

.forgot-link {
  font-size: 26rpx;
  color: #1890ff;
}

.login-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin-bottom: 48rpx;
}

.login-btn:disabled {
  background: #ccc;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider-text {
  font-size: 24rpx;
  color: #999;
  padding: 0 24rpx;
}

.wechat-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.wechat-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.wechat-text {
  font-size: 26rpx;
  color: #07c160;
}

.agreement {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.agreement-text {
  font-size: 22rpx;
  color: #999;
}

.agreement-link {
  font-size: 22rpx;
  color: #1890ff;
}
